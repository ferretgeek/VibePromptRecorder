{
  "name": "vibe-prompt-recorder",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.9"
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm build:web",
    "build:web": "tsc -b && vite build",
    "build:tauri": "tauri build",
    "prepare:tauri": "pnpm audit:schema && node scripts/audit-fonts.mjs --prepare-tauri",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "audit:fonts": "node scripts/audit-fonts.mjs",
    "audit:schema": "node scripts/audit-schema-version.mjs",
    "trace:requirements": "node scripts/requirements-traceability.mjs",
    "trace:check": "node scripts/requirements-traceability.mjs --check",
    "package:portable": "pwsh -NoProfile -File scripts/package-portable.ps1",
    "package:portable:personal": "pwsh -NoProfile -File scripts/package-portable.ps1 -PersonalUse",
    "verify:portable": "pwsh -NoProfile -File scripts/verify-portable.ps1",
    "verify:rust": "pnpm prepare:tauri && cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --locked --workspace --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "verify:desktop": "pnpm verify:rust && tauri build --no-bundle --ci -- --locked",
    "verify": "pnpm trace:check && pnpm audit:fonts && pnpm audit:schema && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build:web && pnpm verify:desktop",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.6",
    "@milkdown/crepe": "7.21.3",
    "@milkdown/kit": "7.21.3",
    "@milkdown/react": "7.21.3",
    "@shikijs/engine-javascript": "4.3.1",
    "@shikijs/langs": "4.3.1",
    "@shikijs/themes": "4.3.1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "2.3.2",
    "@tauri-apps/plugin-opener": "2.5.4",
    "lucide-react": "1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "react-virtuoso": "4.18.11",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.3.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "esbuild": "0.28.1",
    "globals": "^17.0.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
